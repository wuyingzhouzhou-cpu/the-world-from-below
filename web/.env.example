# Sanity (public identifiers — also live in Studio config)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-23

# Public origin for canonical URLs, sitemap, RSS, and structured data.
# Local: http://localhost:3000
# Production: set after the publication hostname is chosen. Do not guess blog.asherlog.me or below.asherlog.me.
NEXT_PUBLIC_SITE_URL=

# Server-only. Optional. Prefer a publicly readable production dataset.
# Needed only if the dataset is private (for example an unclaimed project).
# Never prefix this with NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=

# Server-only. Required in production to view /preview/* routes.
# If unset in production, preview routes return 404.
# PREVIEW_SECRET=
